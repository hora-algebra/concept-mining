+theorem apply_eq_apply_one_of_mem_span_irrTrivialOn {α : G → ℂ}
+    (hα : α ∈ Submodule.span ℤ (irrTrivialOn N)) {z : G} (hz : z ∈ N) : α z = α 1 := by
